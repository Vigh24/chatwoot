FROM chatwoot/chatwoot:latest

# Install required packages
RUN apk add --no-cache \
    postgresql-client \
    redis \
    curl \
    bash \
    tzdata

# Set timezone
ENV TZ=UTC

# Create startup script for free deployment with PostgreSQL (no pgvector)
COPY <<-'EOT' /startup-free.sh
#!/bin/bash
set -e

echo "🚀 Starting Chatwoot (Free Tier - AI Features Disabled)"
echo "======================================================"

# Function to ensure SECRET_KEY_BASE is set
ensure_secret_key() {
  if [ -z "$SECRET_KEY_BASE" ]; then
    echo "🔧 Generating SECRET_KEY_BASE..."
    # Generate a random 128-character hex string
    export SECRET_KEY_BASE=$(openssl rand -hex 64)
    echo "✅ SECRET_KEY_BASE generated"
  else
    echo "✅ SECRET_KEY_BASE already set"
  fi
}

# Function to wait for database
wait_for_db() {
  echo "Waiting for PostgreSQL to be ready..."
  echo "DATABASE_URL: ${DATABASE_URL}"
  
  # Extract database connection details from DATABASE_URL
  if [ -n "$DATABASE_URL" ]; then
    # Parse DATABASE_URL: postgresql://user:pass@host:port/dbname
    # Extract host (everything between @ and : or /)
    DB_HOST=$(echo $DATABASE_URL | sed -n 's/.*@\([^:/]*\).*/\1/p')
    # Extract port (number after host: and before /)
    DB_PORT=$(echo $DATABASE_URL | sed -n 's/.*@[^:]*:\([0-9]*\)\/.*/\1/p')
    # If no port specified, use default
    if [ -z "$DB_PORT" ]; then
      DB_PORT=5432
    fi
    
    export DATABASE_HOST=${DB_HOST}
    export DATABASE_PORT=${DB_PORT}
    
    echo "Extracted DB_HOST: $DATABASE_HOST"
    echo "Extracted DB_PORT: $DATABASE_PORT"
  else
    export DATABASE_HOST=localhost
    export DATABASE_PORT=5432
    echo "Using default database connection"
  fi
  
  # Wait for database connection with timeout
  echo "Testing connection to $DATABASE_HOST:$DATABASE_PORT..."
  max_attempts=60
  attempt=1
  
  while [ $attempt -le $max_attempts ]; do
    if pg_isready -h "$DATABASE_HOST" -p "$DATABASE_PORT" -q; then
      echo "✅ PostgreSQL is ready!"
      return 0
    fi
    echo "Attempt $attempt/$max_attempts: PostgreSQL is unavailable - sleeping"
    sleep 2
    attempt=$((attempt + 1))
  done
  
  echo "❌ Failed to connect to PostgreSQL after $max_attempts attempts"
  return 1
}

# Function to disable AI features (no pgvector)
disable_ai_features() {
  echo "🔧 Disabling AI features for free tier..."
  
  # Apply schema modifications to disable vector features
  if [ -f "/app/db/schema.rb" ]; then
    cp /app/db/schema.rb /app/db/schema.rb.bak
    
    # Remove vector extension and related tables
    sed -i 's/enable_extension "vector"/# enable_extension "vector" # Disabled for free tier/g' /app/db/schema.rb
    sed -i '/create_table "article_embeddings"/,/^  end$/d' /app/db/schema.rb
    sed -i '/create_table "captain_assistant_responses"/,/^  end$/d' /app/db/schema.rb
    sed -i '/create_table "captain_assistants"/,/^  end$/d' /app/db/schema.rb
    sed -i '/create_table "captain_documents"/,/^  end$/d' /app/db/schema.rb
    sed -i '/create_table "captain_inboxes"/,/^  end$/d' /app/db/schema.rb
    sed -i '/create_table "knowledge_entries"/,/^  end$/d' /app/db/schema.rb
    
    # Also modify migration files
    if [ -d "/app/db/migrate" ]; then
      find /app/db/migrate -type f -name "*.rb" -exec sed -i 's/enable_extension "vector"/# enable_extension "vector" # Disabled/g' {} \;
      find /app/db/migrate -type f -name "*.rb" -exec sed -i 's/create_extension :vector/# create_extension :vector # Disabled/g' {} \;
    fi
    
    echo "✅ AI features disabled for free tier deployment"
  fi
}

# Function to setup database
setup_database() {
  echo "🔧 Setting up PostgreSQL database (without pgvector)..."
  
  # Wait for database
  wait_for_db
  
  # Disable AI features
  disable_ai_features
  
  # Create database if it doesn't exist
  echo "Creating database if it doesn't exist..."
  bundle exec rails db:create 2>/dev/null || echo "Database may already exist, continuing..."
  
  # Load schema without vector features
  echo "Loading database schema..."
  DISABLE_DATABASE_ENVIRONMENT_CHECK=1 bundle exec rails db:schema:load || {
    echo "Schema load failed, trying reset..."
    DISABLE_DATABASE_ENVIRONMENT_CHECK=1 bundle exec rails db:reset || {
      echo "Reset failed, trying migrations..."
      DISABLE_DATABASE_ENVIRONMENT_CHECK=1 bundle exec rails db:migrate
    }
  }
  
  # Restore original schema file
  if [ -f "/app/db/schema.rb.bak" ]; then
    cp /app/db/schema.rb.bak /app/db/schema.rb
  fi
  
  echo "✅ Database setup completed!"
}

# Function to start Redis in background (if not using external Redis)
start_redis() {
  if [ -z "$REDIS_URL" ] || [ "$REDIS_URL" = "redis://localhost:6379" ]; then
    echo "Starting local Redis server..."
    redis-server --daemonize yes --port 6379 --bind 127.0.0.1
    sleep 2
    export REDIS_URL="redis://localhost:6379"
    echo "✅ Local Redis server started"
  else
    echo "✅ Using external Redis: $REDIS_URL"
  fi
}

# Function to start services
start_services() {
  echo "🚀 Starting Chatwoot services..."
  
  # Start Sidekiq in background (without deprecated -d flag)
  bundle exec sidekiq -C config/sidekiq.yml &
  
  # Wait a moment for Sidekiq to start
  sleep 2
  echo "✅ Sidekiq background jobs started"
  
  # Start Rails server with explicit binding
  echo "Starting Rails server on 0.0.0.0:${PORT:-3000}..."
  exec bundle exec rails server -b 0.0.0.0 -p ${PORT:-3000} --environment=production
}

# Main execution
echo "🔧 Setting up free tier deployment..."

# Ensure SECRET_KEY_BASE is set
ensure_secret_key

# Setup database
setup_database

# Start Redis
start_redis

# Start services
start_services
EOT

# Make startup script executable
RUN chmod +x /startup-free.sh

# Set the default command
CMD ["/startup-free.sh"]